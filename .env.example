# ── Banco de dados ──────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/bi_aquisicao

# ── ClickUp ─────────────────────────────────────────────────
CLICKUP_API_TOKEN=pk_xxxxxxxxxxxxxxxxxxxx
CLICKUP_WORKSPACE_ID=
CLICKUP_LIST_ID=          # ID da lista/pipeline de vendas

# ── Meta Cloud API ───────────────────────────────────────────
META_APP_ID=
META_APP_SECRET=
META_ACCESS_TOKEN=        # Token de longa duração (60 dias)
META_AD_ACCOUNT_ID=act_xxxxxxxxxxxx
META_PHONE_NUMBER_ID=     # Para extração de disparos WhatsApp
META_WABA_ID=             # WhatsApp Business Account ID

# ── Sistema próprio ──────────────────────────────────────────
SISTEMA_API_URL=https://api.seudominio.com
SISTEMA_API_KEY=
SISTEMA_API_SECRET=

# ── Google Sheets (opcional) ─────────────────────────────────
GOOGLE_SERVICE_ACCOUNT_JSON=./config/service_account.json
GOOGLE_SHEET_ID=

# ── ETL ──────────────────────────────────────────────────────
ETL_RUN_INTERVAL_HOURS=6       # Frequência de sincronização
ETL_LOOKBACK_DAYS=30           # Janela de dados retroativos

# ── Ambiente ─────────────────────────────────────────────────
ENV=development                 # development | production
LOG_LEVEL=INFO
